  "description": "React hooks used at Freckle",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -r dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
